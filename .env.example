# Netlify server-side variables. Do NOT prefix these with VITE_.
GOOGLE_APPS_SCRIPT_URL=
# Generate a long random secret and validate relayToken in your Apps Script before saving a lead.
LEADS_RELAY_TOKEN=
# Private bridges used only by authenticated Netlify functions.
INTERCOAST_CONSOLE_URL=
INTERCOAST_ZELLE_URL=
INTERCOAST_BOT_API_URL=

# POC opcional de Canopy Connect. Mantener apagado hasta configurar los cinco valores.
CANOPY_POC_ENABLED=false
CANOPY_TEAM_ID=
CANOPY_CLIENT_ID=
CANOPY_CLIENT_SECRET=
CANOPY_WEBHOOK_SECRET=
